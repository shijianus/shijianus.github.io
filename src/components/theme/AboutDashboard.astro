---
import { siteConfig } from '../../config/site';
import { ABOUT_I18N_PROFILES, type AboutLocaleCode } from '../../config/about-i18n';

interface Props {
  stats: {
    posts: number;
    categories: number;
    tags: number;
    readingMinutes: number;
  };
  lang?: AboutLocaleCode;
}

const { stats, lang = 'zh-CN' } = Astro.props;
const currentLang: AboutLocaleCode = ABOUT_I18N_PROFILES[lang] ? lang : 'zh-CN';
const p = ABOUT_I18N_PROFILES[currentLang];
const about = siteConfig.pages.about;
const skillMarquee = [...siteConfig.home.hero.skillFlow, ...siteConfig.home.hero.chips];
---

<section id="about-page" data-current-lang={currentLang}>
  <!-- 0. 顶部多语言界面切换器 (Multilingual Profile Switcher) -->
  <div class="about-lang-switch-wrapper">
    <div class="about-lang-switch-bar">
      <span class="lang-switch-label">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span>{p.switchLabel}</span>
      </span>
      <div class="lang-switch-links">
        <a href="/about/" class:list={['lang-switch-item', { active: currentLang === 'zh-CN' }]} data-target-lang="zh-CN" title="简体中文 · 時間 (shijianus)">
          <span class="lang-flag">🇨🇳</span> 简体中文 <span class="lang-alias">(時間)</span>
        </a>
        <a href="/zh-hant/about/" class:list={['lang-switch-item', { active: currentLang === 'zh-Hant' }]} data-target-lang="zh-Hant" title="繁體中文 · 時間">
          <span class="lang-flag">🇭🇰</span> 繁體中文 <span class="lang-alias">(時間)</span>
        </a>
        <a href="/en/about/" class:list={['lang-switch-item', { active: currentLang === 'en' }]} data-target-lang="en" title="English Profile · Kevin Sparks">
          <span class="lang-flag">🇺🇸</span> English <span class="lang-alias">(Kevin Sparks)</span>
        </a>
        <a href="/fr/about/" class:list={['lang-switch-item', { active: currentLang === 'fr' }]} data-target-lang="fr" title="Profil en Français · Léon Boven">
          <span class="lang-flag">🇫🇷</span> Français <span class="lang-alias">(Léon Boven)</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 1. 顶部作者形象与浮动标签 -->
  <div class="author-box">
    <div class="author-tag-left">
      {p.floatingTagsLeft.map((item) => (
        <span class="author-tag">{item}</span>
      ))}
    </div>

    <div class="author-img">
      <img src={siteConfig.site.author.avatar} alt={p.authorName} loading="eager" />
      <span class="online-indicator" title="当前在线 · 持续求索中"></span>
    </div>

    <div class="author-tag-right">
      {p.floatingTagsRight.map((item) => (
        <span class="author-tag">{item}</span>
      ))}
    </div>
  </div>

  <p class="p center logo large">{p.pageTitle}</p>
  <p class="p center small">{p.pageSubtitle}</p>

  <!-- 2. 破冰打招呼与造物追求 -->
  <div class="author-content">
    <div class="author-content-item myInfoAndSayHello">
      <div class="title1">{p.helloTips}</div>
      <div class="title2">
        {currentLang === 'en' ? (
          <>I'm <span class="inline-word">{p.sayHelloName}</span></>
        ) : currentLang === 'fr' ? (
          <>Je m'appelle <span class="inline-word">{p.sayHelloName}</span></>
        ) : currentLang === 'zh-Hant' ? (
          <>我叫 <span class="inline-word">{p.sayHelloName}</span></>
        ) : (
          <>我叫 <span class="inline-word">{p.sayHelloName}</span></>
        )}
      </div>
      <div class="title1 role-desc">{p.helloDescription}</div>
      <div class="hello-tag-chips">
        {p.chips.map((chip) => (
          <span>{chip}</span>
        ))}
      </div>
    </div>

    <div class="author-content-item aboutsiteTips">
      <div class="author-content-item-tips">{p.siteTips.tips}</div>
      <h2>
        {p.siteTips.titleTop}
        <br />
        {p.siteTips.titleBottom}
        <div class="mask">
          {p.siteTips.words.map((word, index) => (
            <span data-show={index === p.siteTips.words.length - 1 ? true : undefined} data-up={index === p.siteTips.words.length - 2 ? true : undefined}>
              {word}
            </span>
          ))}
        </div>
      </h2>
      <p class="aboutsite-lead">
        {p.siteTips.lead}
      </p>
    </div>
  </div>

  <!-- 3. 全宽动态图腾横幅 -->
  <div class="hello-about">
    <div class="shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
    <div class="content">
      <h1>{about.helloWordmark}</h1>
    </div>
  </div>

  <!-- 4. 技能矩阵与生涯长期演进 -->
  <div class="author-content">
    <div class="author-content-item skills">
      <div class="card-content">
        <div class="author-content-item-tips">{p.skills.tips}</div>
        <span class="author-content-item-title">{p.skills.title}</span>

        <div class="skills-style-group">
          <div class="skills-style-group__track">
            {[...skillMarquee, ...skillMarquee].map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>

        <div class="skills-list">
          {about.skills.items.map((item) => (
            <div class="skill-info">
              <div class="skill-icon" style={`background:${item.accent}`}>
                <span>{item.icon}</span>
              </div>
              <div class="skill-name">
                <span>{item.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="author-content-item careers">
      <div class="card-content">
        <div class="author-content-item-tips">{p.careers.tips}</div>
        <span class="author-content-item-title">{p.careers.title}</span>
        <div class="careers-group">
          <div class="careers-item">
            {p.careers.items.map((item) => (
              <div class="circle" style={`background:${item.accent}`}>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. 数据统计与地理时区 -->
  <div class="author-content">
    <div class="author-content-item about-statistic">
      <div class="card-content">
        <div class="author-content-item-tips">{p.stats.tips}</div>
        <span class="author-content-item-title">{p.stats.title}</span>
        <div id="statistic">
          <div>
            <span>文章数目</span>
            <span class="num">{stats.posts}</span>
          </div>
          <div>
            <span>分类数目</span>
            <span class="num">{stats.categories}</span>
          </div>
          <div>
            <span>标签数目</span>
            <span class="num">{stats.tags}</span>
          </div>
          <div>
            <span>阅读时长</span>
            <span class="num">{stats.readingMinutes} min</span>
          </div>
        </div>
        <div class="post-tips">
          所有文章均通过严格 Markdown 管道编译。
          <a href="/archives/">{p.stats.btnLabel}</a>
        </div>
      </div>
    </div>

    <div class="author-content-item author-content-item-map">
      <div class="card-content">
        <div class="author-content-item-tips">{p.map.title}</div>
        <span class="author-content-item-title">{about.map.title}</span>
        <div class="map-time-box">
          <span class="live-clock-badge" id="about-live-clock">--:--:-- PST</span>
          <span class="live-status-pill">{p.map.status}</span>
        </div>
        <div class="map-bg"></div>
      </div>
    </div>
  </div>

  <!-- 6. 人格特质与实景展示 -->
  <div class="author-content">
    <div class="author-content-item personalities">
      <div class="card-content">
        <div class="author-content-item-tips">{p.personality.tips}</div>
        <div class="personality-badge-row">
          <span class="personality-type">{p.personality.type}</span>
          <span class="personality-badge">Advocate / Architect</span>
        </div>
        <span class="author-content-item-title personality-title">{p.personality.title}</span>
        <p class="personality-summary">{p.personality.summary}</p>
        <div class="personality-traits-grid">
          {p.personality.traits.map((trait) => (
            <div class="trait-item">
              <div class="trait-head">
                <span class="trait-label">{trait.label}</span>
                <span class="trait-val">{trait.value}%</span>
              </div>
              <div class="trait-bar-wrap">
                <div class="trait-bar-fill" style={`width: ${trait.value}%`}></div>
              </div>
              <span class="trait-desc">{trait.desc}</span>
            </div>
          ))}
        </div>
        <div class="post-tips">
          源于 16Personalities 心理学类型测定。
          <a href={about.personality.link} target="_blank" rel="noopener noreferrer">查看官方解读</a>
        </div>
      </div>
    </div>

    <div class="author-content-item myphoto">
      <div class="card-content">
        <img class="photo-img" src={siteConfig.site.author.cover} alt={p.photoTitle} />
        <div class="photo-overlay">
          <span class="photo-tag">Real Workspace</span>
          <span class="photo-caption">{p.photoTitle} · 真实求学与折腾的物理角落</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. 生产力工具箱 (普通大学生接地气真实装备) -->
  <div class="author-content">
    <div class="author-content-item gear-card hardware">
      <div class="card-content">
        <div class="author-content-item-tips">{p.gear.tips} / Hardware</div>
        <span class="author-content-item-title">物理工作台</span>
        <p class="gear-desc">{p.gear.hardwareDesc}</p>
        <div class="gear-grid">
          {p.gear.hardware.map((item) => (
            <div class="gear-item">
              <div class="gear-item__icon">
                {item.icon === 'laptop' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="12" x="3" y="4" rx="2"></rect><line x1="2" x2="22" y1="20" y2="20"></line></svg>}
                {item.icon === 'monitor' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg>}
                {item.icon === 'keyboard' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2"></rect><line x1="6" x2="6.01" y1="10" y2="10"></line><line x1="10" x2="10.01" y1="10" y2="10"></line><line x1="14" x2="14.01" y1="10" y2="10"></line><line x1="18" x2="18.01" y1="10" y2="10"></line><line x1="6" x2="6.01" y1="14" y2="14"></line><line x1="18" x2="18.01" y1="14" y2="14"></line><line x1="10" x2="14" y1="14" y2="14"></line></svg>}
                {item.icon === 'headphones' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>}
              </div>
              <div class="gear-item__content">
                <div class="gear-item__name">
                  <strong>{item.name}</strong>
                  {item.badge && <span class="gear-badge">{item.badge}</span>}
                </div>
                <span class="gear-item__desc">{item.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="author-content-item gear-card software">
      <div class="card-content">
        <div class="author-content-item-tips">{p.gear.tips} / Dev Stack</div>
        <span class="author-content-item-title">数字工具箱</span>
        <p class="gear-desc">{p.gear.softwareDesc}</p>
        <div class="gear-grid">
          {p.gear.software.map((item) => (
            <div class="gear-item">
              <div class="gear-item__icon software-icon">
                {item.icon === 'code' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>}
                {item.icon === 'zap' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
                {item.icon === 'figma' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z"></path><path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z"></path><path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 1 1-7 0z"></path><path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z"></path><path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z"></path></svg>}
                {item.icon === 'cloud' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg>}
              </div>
              <div class="gear-item__content">
                <div class="gear-item__name">
                  <strong>{item.name}</strong>
                  {item.badge && <span class="gear-badge">{item.badge}</span>}
                </div>
                <span class="gear-item__desc">{item.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 8. 数字花园建站宣言与造物初心 -->
  <div class="author-content">
    <div class="author-content-item single manifesto-card">
      <div class="card-content">
        <div class="manifesto-header">
          <span class="manifesto-pill">
            <span class="manifesto-pill__sparkle">✦</span> {p.manifesto.tips}
          </span>
          <h2 class="manifesto-title">{p.manifesto.title}</h2>
          <p class="manifesto-subtitle">{p.manifesto.subtitle}</p>
        </div>

        <div class="manifesto-pillars">
          {p.manifesto.pillars.map((pillar) => (
            <div class="pillar-card">
              <div class="pillar-card__head">
                <span class="pillar-card__tag">{pillar.tag}</span>
                <div class="pillar-card__icon">
                  {pillar.icon === 'shield' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
                  {pillar.icon === 'feather' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line x1="16" y1="8" x2="2" y2="22"></line><line x1="17.5" y1="15" x2="9" y2="15"></line></svg>}
                  {pillar.icon === 'hammer' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"></path><path d="M17.64 15 22 10.64"></path><path d="m20.91 3.26-6.36 6.36"></path></svg>}
                </div>
              </div>
              <strong class="pillar-card__title">{pillar.title}</strong>
              <p class="pillar-card__desc">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 8.5 全栈工程架构三层拓扑与云端底座 (Topology & Cloud Deck) -->
  <div class="author-content">
    <div class="author-content-item single topology-card">
      <div class="card-content">
        <div class="author-content-item-tips">{p.topology.tips}</div>
        <span class="author-content-item-title">{p.topology.title}</span>
        <p class="topology-lead">{p.topology.lead}</p>

        <div class="topology-tiers-grid">
          {p.topology.tiers.map((tier) => (
            <div class="topology-tier-box">
              <div class="topology-tier-head">
                <span class="tier-badge-num">{tier.num}</span>
                <div class="tier-badge-title">
                  <strong>{tier.title}</strong>
                  <span>{tier.subtitle}</span>
                </div>
              </div>
              <div class="topology-chips-flow">
                {tier.items.map((item) => (
                  <div class="topology-item">
                    <span class={`tier-dot ${item.dot}`}></span>
                    <strong class="item-name">{item.name}</strong>
                    <span class="item-role">{item.desc}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 9. 音乐偏好与造物热爱 -->
  <div class="author-content">
    <div class="author-content-item like-music">
      <div class="card-content">
        <div class="author-content-item-tips">{p.soundtrack.tips}</div>
        <span class="author-content-item-title">{p.soundtrack.title}</span>
        <div class="vinyl-player-widget">
          <div class="vinyl-record-disc rotating-vinyl">
            <div class="vinyl-label-center">
              <img src={about.soundtrack.cover} alt="Vinyl Track" class="vinyl-cover-art" />
            </div>
          </div>
          <div class="vinyl-info-pane">
            <span class="vinyl-status-badge">✦ Current Flow</span>
            <strong class="vinyl-song-title">{p.soundtrack.song}</strong>
            <span class="vinyl-artist-meta">{p.soundtrack.artist}</span>
            <div class="equalizer-bars">
              <span class="bar bar-1"></span>
              <span class="bar bar-2"></span>
              <span class="bar bar-3"></span>
              <span class="bar bar-4"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="author-content-item game-yuanshen">
      <div class="card-content">
        <div class="author-content-item-tips">{p.game.tips}</div>
        <span class="author-content-item-title">{p.game.title}</span>
        <p class="game-summary">{p.game.summary}</p>
        <div class="game-meta-row">
          <span class="comic-tips">{p.comic.title}</span>
          <div class="comic-box">
            {p.comic.items.map((item) => (
              <span class="comic-item">{item}</span>
            ))}
          </div>
        </div>
        <div class="loading-bar-wrap">
          <div class="loading-bar-inner"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 9.5 演进足迹与成长里程碑 (结合生于 2006 年与大学经历) -->
  <div class="author-content">
    <div class="author-content-item single milestones-card">
      <div class="card-content">
        <div class="author-content-item-tips">{p.milestones.tips}</div>
        <span class="author-content-item-title">{p.milestones.title}</span>
        <p class="milestones-lead">{p.milestones.lead}</p>

        <div class="milestones-track">
          {p.milestones.items.map((node) => (
            <div class="milestone-node">
              <div class="node-indicator">
                <span class:list={['node-dot', { 'future-dot': node.isFuture }]}></span>
                {!node.isFuture && <span class="node-line"></span>}
              </div>
              <div class="node-body">
                <div class="node-meta">
                  <span class:list={['node-year', { 'future-year': node.isFuture }]}>{node.year}</span>
                  <span class:list={['node-tag', { 'current-tag': node.isCurrent, 'future-tag': node.isFuture }]}>{node.tag}</span>
                </div>
                <strong class="node-title">{node.title}</strong>
                <p class="node-desc">{node.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 10. 箴言与状态加成 -->
  <div class="author-content">
    <div class="author-content-item maxim">
      <div class="card-content">
        <div class="author-content-item-tips">{p.maxim.tips}</div>
        <span class="maxim-title">
          <span>{p.maxim.top}</span>
          <span>{p.maxim.bottom}</span>
        </span>
        <p class="maxim-annotation">{p.maxim.annotation}</p>
      </div>
    </div>

    <div class="author-content-item buff">
      <div class="card-content">
        <div class="author-content-item-tips">{p.buff.tips}</div>
        <span class="buff-title">
          <span>{p.buff.top}</span>
          <span>{p.buff.bottom}</span>
        </span>
      </div>
    </div>
  </div>

  <!-- 11. 保持连接与志同道合者矩阵 -->
  <div class="author-content">
    <div class="author-content-item single connect-card">
      <div class="card-content">
        <div class="connect-head">
          <div class="author-content-item-tips">{p.connect.tips}</div>
          <span class="author-content-item-title">{p.connect.title}</span>
          <p class="connect-summary">{p.connect.summary}</p>
        </div>

        <div class="connect-buttons-grid">
          {p.connect.items.map((item) => (
