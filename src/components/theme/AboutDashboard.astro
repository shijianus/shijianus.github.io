<!-- 实时时钟、多语言切换与微交互运行脚本 -->
<script is:inline>
  (() => {
    // 1. 实时 PST/PDT 太平洋时间更新
    const updateClock = () => {
      const clockEl = document.getElementById('about-live-clock');
      if (!clockEl) return;
      try {
        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Los_Angeles',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
        clockEl.textContent = `${formatter.format(now)} PST`;
      } catch (e) {
        clockEl.textContent = new Date().toLocaleTimeString('zh-CN', { hour12: false }) + ' Local';
      }
    };

    updateClock();
    const timer = setInterval(updateClock, 1000);
    window.addEventListener('beforeunload', () => clearInterval(timer), { once: true });

    // 2. 多语言切换导航交互与状态同步
    const langLinks = document.querySelectorAll('.lang-switch-item');
    langLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetLang = link.getAttribute('data-target-lang');
        if (targetLang) {
          try {
            window.localStorage.setItem('shijianus-locale-variant', targetLang);
            window.localStorage.setItem('shijianus-manual-locale-selected', targetLang);
            window.dispatchEvent(new CustomEvent('shijianus:localechange', { detail: targetLang }));
          } catch {}
        }
      });
    });

    // 3. 全局语言变更感知：如果在关于页，根据全局语言选择平滑映射
    window.addEventListener('shijianus:localechange', (e) => {
      const nextLang = e && e.detail;
      if (!nextLang) return;
      const currentPath = window.location.pathname.replace(/\/$/, '');
      const routeMap = {
        'zh-CN': '/about',
        'zh-Hant': '/zh-hant/about',
        'en': '/en/about',
        'fr': '/fr/about',
      };
      const targetPath = routeMap[nextLang];
      if (targetPath && currentPath !== targetPath && currentPath.includes('about')) {
        window.location.href = targetPath + '/';
      }
    });
  })();
</script>

